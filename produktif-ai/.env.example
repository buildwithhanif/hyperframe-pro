# Required in production: your Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=

# Optional: set to 1 to serve a built-in sample deck without calling the API.
# Useful for local UI work and tests. Never set this in production.
DEMO_MODE=

# Optional: max generations per IP per hour (default 8). 0 stops all generation.
RATE_LIMIT_PER_HOUR=

# Waitlist: where each signup is POSTed as JSON (e.g. a Google Apps Script web app).
WAITLIST_WEBHOOK_URL=
# Optional: sent as "secret" in each row so the receiver can reject forged posts.
WAITLIST_WEBHOOK_SECRET=

# Optional: max generations per server instance per hour (default 200).
# Also set a monthly spend limit in the Anthropic Console: that is the real cap.
GLOBAL_LIMIT_PER_HOUR=
