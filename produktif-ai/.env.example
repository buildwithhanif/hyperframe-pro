# --- Applications (Get started → waitlist) ---

# Required: the Google Apps Script web app URL (see README, "The sheet").
WAITLIST_WEBHOOK_URL=
# Strongly recommended: sent as "secret" in each row. Must match SECRET in the script.
WAITLIST_WEBHOOK_SECRET=
# Recommended: signs the "finish my profile" links. Any long random string.
APPLY_SECRET=

# Optional: the business WhatsApp number you message applicants from, e.g. +62 812 0000 0000.
NEXT_PUBLIC_WA_NUMBER=

# Optional: confirmation email through Resend. EMAIL_FROM must use a verified domain.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Optional: base URL for links in the email (default https://produktif.ai).
SITE_URL=

# --- Carousel tool (/carousel) ---

# Only needed if you want /carousel live. Set a monthly spend limit in the Anthropic Console first.
ANTHROPIC_API_KEY=
# Optional: max generations per IP per hour (default 8). 0 stops all generation.
RATE_LIMIT_PER_HOUR=
# Optional: max generations per server instance per hour (default 200).
GLOBAL_LIMIT_PER_HOUR=

# --- Local only ---

# 1 = accept applications without a webhook and serve a sample carousel. Never in production.
DEMO_MODE=
